{
  "name": "onyx-defaults",
  "displayName": "Onyx Defaults",
  "description": "Ships Onyx's Warp-styled default settings.",
  "version": "1.0.0",
  "publisher": "onyx",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "contributes": {
    "configurationDefaults": {
      "workbench.colorTheme": "Dark Modern",
      "workbench.colorCustomizations": {
        "editor.background": "#000000",
        "terminal.background": "#000000",
        "panel.background": "#000000",
        "sideBar.background": "#0a0a0a",
        "activityBar.background": "#0a0a0a",
        "titleBar.activeBackground": "#0a0a0a",
        "statusBar.background": "#0a0a0a",
        "editorGroupHeader.tabsBackground": "#0a0a0a",
        "tab.inactiveBackground": "#0a0a0a",
        "tab.activeBackground": "#000000",
        "input.background": "#141414",
        "dropdown.background": "#141414",
        "editorWidget.background": "#0f0f0f",
        "quickInput.background": "#0f0f0f",
        "editor.foreground": "#ffffff",
        "terminal.foreground": "#ffffff",
        "focusBorder": "#00c2ff",
        "tab.activeBorderTop": "#00c2ff",
        "activityBar.activeBorder": "#00c2ff",
        "progressBar.background": "#00c2ff",
        "textLink.foreground": "#00c2ff",
        "button.background": "#00c2ff",
        "button.foreground": "#000000",
        "editorCursor.foreground": "#00c2ff",
        "terminalCursor.foreground": "#00c2ff",
        "statusBarItem.remoteBackground": "#00c2ff",
        "panel.border": "#1a1a1a",
        "sideBar.border": "#1a1a1a",
        "editorGroup.border": "#1a1a1a",
        "tab.border": "#0a0a0a",
        "terminal.ansiBlack": "#616161",
        "terminal.ansiRed": "#ff8272",
        "terminal.ansiGreen": "#b4fa72",
        "terminal.ansiYellow": "#fefdc2",
        "terminal.ansiBlue": "#a5d5fe",
        "terminal.ansiMagenta": "#ff8ffd",
        "terminal.ansiCyan": "#d0d1fe",
        "terminal.ansiWhite": "#f1f1f1",
        "terminal.ansiBrightBlack": "#8e8e8e",
        "terminal.ansiBrightRed": "#ffc4bd",
        "terminal.ansiBrightGreen": "#d6fcb9",
        "terminal.ansiBrightYellow": "#fefdd5",
        "terminal.ansiBrightBlue": "#c1e3fe",
        "terminal.ansiBrightMagenta": "#ffb1fe",
        "terminal.ansiBrightCyan": "#e5e6fe",
        "terminal.ansiBrightWhite": "#feffff"
      },
      "editor.fontFamily": "Hack, Menlo, monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 1.6,
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "gutter",
      "editor.scrollbar.verticalScrollbarSize": 6,
      "editor.scrollbar.horizontalScrollbarSize": 6,
      "breadcrumbs.enabled": false,
      "terminal.integrated.fontFamily": "Hack, Menlo, monospace",
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.lineHeight": 1.3,
      "terminal.integrated.cursorStyle": "block",
      "terminal.integrated.defaultLocation": "editor",
      "terminal.integrated.tabs.enabled": true,
      "terminal.integrated.shellIntegration.decorationsEnabled": "both",
      "terminal.integrated.stickyScroll.enabled": true,
      "workbench.activityBar.location": "top",
      "workbench.layoutControl.enabled": false,
      "workbench.editor.tabSizing": "shrink",
      "workbench.editor.empty.hint": "hidden",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.tree.renderIndentGuides": "none",
      "workbench.tree.indent": 12,
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.commandCenter": true
    }
  }
}
