+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Onyx contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+export interface IEnablementInput {
+	settingEnabled: boolean;
+	hasCommandDetection: boolean;
+	xtermOpened: boolean;
+	screenReaderOptimized: boolean;
+}
+
+/**
+ * Blocks exist only with the setting on, shell integration detected, xterm in the DOM, and no
+ * screen reader (the stock terminal's accessible buffer serves screen reader users).
+ */
+export function shouldEnableBlocks(input: IEnablementInput): boolean {
+	return input.settingEnabled && input.hasCommandDetection && input.xtermOpened && !input.screenReaderOptimized;
+}
