+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Onyx contributors. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { strictEqual } from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { shouldEnableBlocks } from '../../browser/onyxBlocksEnablement.js';
+
+suite('Onyx blocks enablement', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('enabled when setting on, command detection present and xterm open', () => {
+		strictEqual(shouldEnableBlocks({ settingEnabled: true, hasCommandDetection: true, xtermOpened: true, screenReaderOptimized: false }), true);
+	});
+
+	test('disabled when the setting is off', () => {
+		strictEqual(shouldEnableBlocks({ settingEnabled: false, hasCommandDetection: true, xtermOpened: true, screenReaderOptimized: false }), false);
+	});
+
+	test('disabled without shell integration (no command detection)', () => {
+		strictEqual(shouldEnableBlocks({ settingEnabled: true, hasCommandDetection: false, xtermOpened: true, screenReaderOptimized: false }), false);
+	});
+
+	test('disabled before xterm is in the DOM', () => {
+		strictEqual(shouldEnableBlocks({ settingEnabled: true, hasCommandDetection: true, xtermOpened: false, screenReaderOptimized: false }), false);
+	});
+
+	test('disabled when a screen reader is in use', () => {
+		strictEqual(shouldEnableBlocks({ settingEnabled: true, hasCommandDetection: true, xtermOpened: true, screenReaderOptimized: true }), false);
+	});
+});
